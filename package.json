{
  "name": "kokiportfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "lint:html": "node tools/lint-html.mjs",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:css && npm run build && npm run lint:html",
    "format": "prettier --write src"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "html-validate": "^9.0.0",
    "postcss-preset-env": "^10.0.0",
    "prettier": "^3.5.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^38.0.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "swiper": "^14.2.0"
  }
}
